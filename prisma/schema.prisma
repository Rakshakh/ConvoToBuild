// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  whatsappId    String    @unique
  name          String?
  email         String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  conversations Conversation[]
  projects      Project[]
  
  @@map("users")
}

model Conversation {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  status      String    @default("active") // active, completed, archived
  context     Json?     // Stores conversation context
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  messages    Message[]
  
  @@map("conversations")
}

model Message {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            String       // user, assistant, system
  content         String       @db.Text
  metadata        Json?        // For storing additional data like media URLs
  createdAt       DateTime     @default(now())
  
  @@map("messages")
  @@index([conversationId])
}

model Project {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  description     String?   @db.Text
  type            String    // web, landing-page, crud, api, dashboard
  status          String    @default("generating") // generating, deployed, failed, archived
  githubRepo      String?
  deploymentUrl   String?
  vercelProjectId String?
  techStack       Json?     // Stores technology choices
  envVariables    Json?     // Encrypted environment variables
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  conversations   Conversation[]
  versions        ProjectVersion[]
  deployments     Deployment[]
  
  @@map("projects")
}

model ProjectVersion {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version     Int
  commitHash  String?
  changes     String    @db.Text
  fileChanges Json?     // Stores file diffs
  createdAt   DateTime  @default(now())
  
  @@map("project_versions")
  @@index([projectId])
}

model Deployment {
  id              String    @id @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deploymentUrl   String
  vercelDeployId  String?
  status          String    // building, ready, error, canceled
  buildLogs       String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@map("deployments")
  @@index([projectId])
}

model Template {
  id          String    @id @default(cuid())
  name        String    @unique
  type        String    // web, landing-page, crud, api, dashboard
  description String?   @db.Text
  structure   Json      // File structure and templates
  defaults    Json?     // Default configurations
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@map("templates")
}
